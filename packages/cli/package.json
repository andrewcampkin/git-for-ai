{
  "name": "git-for-ai",
  "version": "0.0.0",
  "private": true,
  "description": "git-for-ai: intent-aware source control, layered on Git. `git for-ai <command>`.",
  "type": "module",
  "bin": {
    "git-for-ai": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@git-for-ai/core": "workspace:*",
    "@git-for-ai/review-ui": "workspace:*",
    "@git-for-ai/schemas": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "picocolors": "^1.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
