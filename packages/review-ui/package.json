{
  "name": "@git-for-ai/review-ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "The local review web app SPA (architecture/REVIEW_UI.md): static Vite + React build served by `git for-ai review`. No node/git logic; talks only to the CLI's read-only JSON API.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@git-for-ai/schemas": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
