{
  "name": "@git-for-ai/core",
  "version": "0.0.0",
  "private": true,
  "description": "git-for-ai engine: git access, identity resolution, ledger + session read/write, redaction, embedding pipeline, vector store. No CLI parsing, no UI, no HTTP. See architecture/ARCHITECTURE.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@git-for-ai/schemas": "workspace:*",
    "@xenova/transformers": "^2.17.0",
    "execa": "^9.0.0",
    "sqlite-vec": "^0.1.9",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
